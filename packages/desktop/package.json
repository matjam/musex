{
  "name": "@musex/desktop",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "Spotify-style desktop player for your Plex music library",
  "author": "Nathan Ollerenshaw <nathan@ollerenshaw.org>",
  "homepage": "https://github.com/matjam/musex",
  "desktopName": "musex.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/fetch-mpv.mjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --publish never",
    "package:ci": "electron-vite build && electron-builder --publish never -c.mac.notarize=false"
  },
  "dependencies": {
    "@ctrl/plex": "^6.0.0",
    "@musex/core": "workspace:*",
    "@musex/plugin-api": "workspace:*",
    "@musex/plugin-host": "workspace:*",
    "@tanstack/react-virtual": "^3.14.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "lucide-react": "^1.17.0",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "42.3.3",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
