{
  "expo": {
    "name": "musex",
    "slug": "musex",
    "owner": "stupendous-net",
    "scheme": "musex",
    "version": "0.17.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "net.stupendous.musex",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "musex connects to Plex Media Servers on your local network to stream your music library.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "2"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5206eae6-c9d8-4a2a-be51-60da521a6c62"
      }
    }
  }
}
